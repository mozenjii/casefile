# Copy to .env and fill in, or export these in your shell. Nothing here is needed to run the
# project: with no provider set, the specialists use an offline stand-in and nothing costs money.

# Which model the specialists use: reference (default), openrouter, anthropic, together, groq,
# fireworks, deepinfra, ollama or openai-compatible.
CASEFILE_PROVIDER=reference

# Recommended: one OpenRouter key reaches many hosted open-weights models for fractions of a cent.
# OPENROUTER_API_KEY=

# Or Anthropic directly (defaults to claude-opus-5-5; try claude-sonnet-5-5 or claude-haiku-5-5).
# ANTHROPIC_API_KEY=

# Keys for the other hosts, if you pick one of them (they also need CASEFILE_MODEL):
# TOGETHER_API_KEY=
# GROQ_API_KEY=
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=

# Optional overrides.
# CASEFILE_MODEL=deepseek/deepseek-v4-pro
# CASEFILE_BASE_URL=https://openrouter.ai/api/v1
# CASEFILE_API_KEY=
# CASEFILE_EFFORT=low
# CASEFILE_PRICE_INPUT=0.209
# CASEFILE_PRICE_OUTPUT=0.418
